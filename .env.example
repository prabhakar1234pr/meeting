# ─── MeetStream ───────────────────────────────────────────────
MEETSTREAM_API_KEY=
# Public URLs MeetStream uses to reach your LOCAL webhooks + audio bridge.
# Run a tunnel:  ngrok http 8000   (or: cloudflared tunnel --url http://localhost:8000)
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
PUBLIC_WS_URL=wss://your-tunnel.ngrok.app

# ─── OpenAI (LLM) ─────────────────────────────────────────────
OPENAI_API_KEY=
LLM_RESPONDER_MODEL=gpt-4o-mini
LLM_BRIEF_MODEL=gpt-4o

# ─── ElevenLabs — voice (TTS) ─────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# ─── Redis (transcription bus) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MeetStream streaming STT provider (for live transcription) ─
TRANSCRIPT_PROVIDER=deepgram_streaming

# ─── App ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DB_PATH=./data/app.db
CHROMA_PATH=./data/chroma
DEFAULT_TENANT_ID=local
# Standard wake word to address any agent in a meeting (its name/wake phrase also work)
WAKE_WORD=hey assistant

# ─── Scalekit (identity: per-user/tenant access + login) ──────
# SCALEKIT_ENVIRONMENT_URL=
# SCALEKIT_CLIENT_ID=
# SCALEKIT_CLIENT_SECRET=

# ─── Auth / sessions (Scalekit Full Stack Auth) ───────────────
# AUTH_ENABLED=false                                   # true = require login
# These two URLs must BOTH be registered in the Scalekit dashboard under
# Authentication → Redirect URLs, matched EXACTLY (scheme, host, port, path —
# no trailing slash). The login callback is separate from the post-logout URL:
# registering only the callback is why the Sign out button returns
# `post_logout_redirect_uri invalid`.
# AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# AUTH_POST_LOGOUT_URI=http://localhost:8000           # leave empty to skip the redirect
#
# ALSO set the "Initiate Login URI" (Dashboard → Authentication → Redirects) to
#   http://localhost:8000/auth/login
# Flows that start OUTSIDE the app (clicking "Accept invite" in an invitation
# email) land there with an ?idp_initiated_login=<token>; /auth/login decodes it
# and resumes the login. Without it, invitees hit Scalekit's own hosted page.
